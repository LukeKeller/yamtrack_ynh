# Yamtrack configuration for YunoHost
# This file is managed by YunoHost. Do not edit manually.

# Django
SECRET=__SECRET__
DEBUG=False
ALLOWED_HOSTS=__DOMAIN__
CSRF=https://__DOMAIN__
URLS=https://__DOMAIN____PATH__

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=__DB_NAME__
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PWD__

# Redis
REDIS_URL=redis://localhost:6379/__REDIS_DB__

# Timezone
TZ=__TIMEZONE__

# Logout redirects to YunoHost SSO
ACCOUNT_LOGOUT_REDIRECT_URL=https://__DOMAIN__/yunohost/sso/?action=logout

# TLS CA bundle for outgoing HTTPS requests (e.g. OIDC/Dex discovery)
REQUESTS_CA_BUNDLE=__INSTALL_DIR__/certs/ca-bundle.crt

# Library uploads (OPDS server). Lives in $data_dir so user-uploaded
# epubs + extracted covers survive `ynh_setup_source --full_replace` on
# every upgrade and are picked up by `ynh_backup "$data_dir"` in backups.
MEDIA_ROOT=__DATA_DIR__/media

# Media import integrations (configurable via YunoHost UI or by editing this file)
TRAKT_API=
TRAKT_API_SECRET=
SIMKL_ID=
SIMKL_SECRET=
ANILIST_ID=
ANILIST_SECRET=
STEAM_API_KEY=

# Metadata enrichment (optional). OMDb surfaces Rotten Tomatoes, Metacritic,
# IMDb ratings and US box office on movie/TV detail pages. Get a free key at
# https://www.omdbapi.com/apikey.aspx (1,000 requests/day on the free tier).
OMDB_API=

# SSO / OIDC settings are appended below by the install/upgrade script
